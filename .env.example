# Lab-in-a-Box placeholder credentials — lab use only.
# Copy to .env and change anything you like. .env is gitignored.

SEED_USER=labuser
SEED_PASS=labpass123

# ssh-lab placeholder server auth (read by the container at startup)
SSH_SEED_USER=labuser
SSH_SEED_PASS=labpass123

# DVWA built-in admin — the stock vulnerable/web-dvwa image hardcodes these;
# they are not overridable via env on that image.
DVWA_ADMIN_USER=admin
DVWA_ADMIN_PASS=password
